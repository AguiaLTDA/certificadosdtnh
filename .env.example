# ------------------------------------------------------------------
# Plataforma de Certificados UNIVC - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores.
# ------------------------------------------------------------------

# URL publica da plataforma. E ESTA a URL que vai dentro do QR Code.
# Em producao use o dominio real (https://certificados.univc.br, por exemplo).
BASE_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------
# Acesso administrativo
# Gere o hash com: npm run setup:admin
# ------------------------------------------------------------------
ADMIN_USUARIO=admin
ADMIN_SENHA_HASH=
# Segredo usado para assinar o cookie de sessao (string longa e aleatoria)
SESSION_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Segredo usado no HMAC do codigo de autenticacao dos certificados.
# NUNCA troque depois de emitir certificados: invalidaria a verificacao de integridade.
CODIGO_SECRET=troque-este-valor-por-outra-string-aleatoria-longa

# ------------------------------------------------------------------
# Armazenamento / base de dados
# STORAGE_DRIVER=drive  -> Google Drive (producao)
# STORAGE_DRIVER=local  -> pasta ./dados-locais (desenvolvimento, sem Google)
# ------------------------------------------------------------------
STORAGE_DRIVER=local

# Pasta raiz no Google Drive onde tudo sera criado.
# Deixe em branco para a plataforma criar "Certificados UNIVC" na raiz do seu Drive.
DRIVE_PASTA_RAIZ_ID=

# GOOGLE_AUTH_MODE=oauth            -> usa SEU Google Drive pessoal/institucional (recomendado)
# GOOGLE_AUTH_MODE=service_account  -> usa conta de servico (exige Shared Drive)
GOOGLE_AUTH_MODE=oauth

# --- Modo oauth (npm run setup:google gera o refresh token) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# --- Modo service_account ---
# Caminho para o JSON da conta de servico OU o JSON inteiro em uma linha.
GOOGLE_SERVICE_ACCOUNT_FILE=./credenciais/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------
# Entrega do PDF na pagina publica de validacao
# proxy = o PDF e servido pela propria plataforma (Drive fica privado) [recomendado]
# drive = a pagina mostra o link direto do Google Drive (exige arquivo compartilhado)
# ------------------------------------------------------------------
ENTREGA_PDF=proxy

# ------------------------------------------------------------------
# Identificacao institucional (aparece no certificado e no rodape)
# ------------------------------------------------------------------
INSTITUICAO_NOME=Centro Universitario Vale do Cricare
INSTITUICAO_SIGLA=UNIVC
INSTITUICAO_MANTENEDORA=Instituto Vale do Cricare
INSTITUICAO_CIDADE=Sao Mateus
INSTITUICAO_UF=ES
INSTITUICAO_SITE=https://www.univc.br
INSTITUICAO_CNPJ=
INSTITUICAO_CREDENCIAMENTO=
